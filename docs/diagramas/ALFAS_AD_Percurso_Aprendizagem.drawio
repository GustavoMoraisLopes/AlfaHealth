"80" width="30" height="30" as="geometry"/></mxCell><mxCell id="D0" value="Conta no estado Ativo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="320" height="120" as="geometry"/></mxCell><mxCell id="bloq" value="Sistema bloqueia o acesso e indica o motivo" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="172" width="260" height="60" as="geometry"/></mxCell><mxCell id="fim1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="943" y="270" width="34" height="34" as="geometry"/></mxCell><mxCell id="I1" value="Utilizador escolhe um Recurso publicado" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="290" width="300" height="60" as="geometry"/></mxCell><mxCell id="I2" value="Utilizador inscreve-se no Recurso" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="300" height="60" as="geometry"/></mxCell><mxCell id="I3" value="Sistema cria a Inscrição no estado Inscrito" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="380" width="300" height="60" as="geometry"/></mxCell><mxCell id="G1" value="Sistema cria a Tentativa do diagnóstico" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="470" width="300" height="60" as="geometry"/></mxCell><mxCell id="G2" value="Utilizador responde às Perguntas" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="560" width="300" height="60" as="geometry"/></mxCell><mxCell id="G3" value="Utilizador submete o questionário" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="650" width="300" height="60" as="geometry"/></mxCell><mxCell id="G4" value="Sistema corrige, guarda as RespostasDaTentativa e calcula a nota de 0 a 100" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="740" width="300" height="60" as="geometry"/></mxCell><mxCell id="G5" value="Inscrição passa a Em curso" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="830" width="300" height="60" as="geometry"/></mxCell><mxCell id="D1" value="Utilizador pretende repetir o diagnóstico e ainda tem tentativas? (máximo de 2)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="920" width="320" height="120" as="geometry"/></mxCell><mxCell id="R1" value="Utilizador consulta o nível do Recurso: vídeo e PDF" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="1075" width="300" height="60" as="geometry"/></mxCell><mxCell id="R2" value="Sistema regista o progresso do nível" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="1075" width="300" height="60" as="geometry"/></mxCell><mxCell id="D2" value="Há mais níveis por consultar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="1165" width="320" height="120" as="geometry"/></mxCell><mxCell id="Q1" value="Sistema cria a Tentativa do questionário final" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="1315" width="300" height="60" as="geometry"/></mxCell><mxCell id="Q2" value="Utilizador responde às Perguntas" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="1405" width="300" height="60" as="geometry"/></mxCell><mxCell id="Q3" value="Utilizador submete o questionário" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="1495" width="300" height="60" as="geometry"/></mxCell><mxCell id="Q4" value="Sistema corrige, guarda as RespostasDaTentativa e calcula a nota de 0 a 100" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="1585" width="300" height="60" as="geometry"/></mxCell><mxCell id="D3" value="Nota ≥ notaMínima do Questionário? (85 por omissão)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="1675" width="320" height="120" as="geometry"/></mxCell><mxCell id="C1" value="Sistema cria a Conclusão com código de certificado, associada à Tentativa que atingiu a notaMínima" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="1825" width="300" height="60" as="geometry"/></mxCell><mxCell id="C2" value="Inscrição passa a Concluído" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="1915" width="300" height="60" as="geometry"/></mxCell><mxCell id="C3" value="Sistema atribui o badge do Recurso e disponibiliza o certificado" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="2005" width="300" height="60" as="geometry"/></mxCell><mxCell id="C4" value="Sem Conclusão, badge nem certificado. A Inscrição mantém-se Em curso. Não há nova tentativa" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="1830" width="260" height="60" as="geometry"/></mxCell><mxCell id="X1" value="Sistema apresenta a nota, a comparação pré/pós, o ganho absoluto e o ganho normalizado" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="2095" width="300" height="60" as="geometry"/></mxCell><mxCell id="fim" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="623" y="2185" width="34" height="34" as="geometry"/></mxCell><mxCell id="N1" value="O ganho de aprendizagem usa sempre a nota da 1.ª Tentativa do diagnóstico" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8dc;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="725" width="240" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>