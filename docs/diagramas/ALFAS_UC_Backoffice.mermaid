flowchart LR
  regb["Utilizador Registado"]
  mg["Manager"]
  ad["Administrador"]

  mg -->|herda de| regb
  ad -->|herda de| mg

  subgraph SYS["Sistema ALFAS - Backoffice"]
    subgraph M["Manager"]
      M1(["Gerir recursos e níveis (inclui badge e estado de publicação)"])
      M2(["Gerir questionários, perguntas e opções (máx. tentativas e nota mínima)"])
      M3(["Gerir biblioteca virtual"])
      M4(["Gerir notícias"])
      M5(["Gerir agenda"])
      M6(["Gerir áreas de saúde"])
      M7(["Gerir destaques da semana"])
      M8(["Gerir traduções PT/EN"])
      M9(["Consultar inscrições e taxa de conclusão"])
      M10(["Consultar dashboard estatístico"])
      M11(["Exportar respostas e notas em CSV"])
      M12(["Aplicar filtros: recurso, área de saúde, ano de escolaridade, período"])
    end
    subgraph TEPMS["Estatística TEPMS (calculada a partir da base de dados)"]
      S1(["Indicadores gerais: utilizadores registados e ativos, recursos publicados, inscrições, taxa de conclusão"])
      S2(["Ganho de aprendizagem absoluto e normalizado g (1.ª tentativa do diagnóstico)"])
      S3(["Distribuição das notas: média, mediana, desvio-padrão, mínimo e máximo"])
      S4(["Análise de perguntas: % de respostas certas e discriminação"])
      S5(["Comparar grupos: intervalos de confiança e testes de hipóteses"])
      S6(["Simular cenários: reamostragem para amostras pequenas"])
      S7(["Evolução das notas no tempo"])
    end
    subgraph A["Administrador"]
      A1(["Gerir utilizadores e estado da conta"])
      A2(["Atribuir perfis aos utilizadores"])
      A3(["Consultar e revogar consentimentos parentais"])
      A4(["Gerir idiomas"])
      A5(["Gerir tabelas de domínio: géneros, anos de escolaridade, tipos e estados"])
    end
  end

  mg --- M1 & M2 & M3 & M4 & M5 & M6 & M7 & M9 & M10 & M11
  ad --- A1 & A2 & A3 & A4 & A5

  M1 -. include .-> M8
  M2 -. include .-> M8
  M3 -. include .-> M8
  M4 -. include .-> M8
  M5 -. include .-> M8
  M6 -. include .-> M8
  M10 -. include .-> S1 & S2 & S3 & S4 & S5 & S6 & S7
  M10 -. include .-> M12
  M11 -. include .-> M12
