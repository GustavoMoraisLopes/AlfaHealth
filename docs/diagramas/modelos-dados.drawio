        <mxCell id="y4RPKczwulwyIABgjovu-14" edge="1" parent="1" source="y4RPKczwulwyIABgjovu-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERoneToMany;startFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="v11-46">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="1025" /><mxPoint x="580" y="215" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="y4RPKczwulwyIABgjovu-15" edge="1" parent="1" source="y4RPKczwulwyIABgjovu-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERoneToMany;startFill=0;" target="gZFmSahJWme06St8x247-23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="decisao-p1" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;P1 – Resposta a cada pergunta&lt;/b&gt;&lt;br&gt;quiz_user → &lt;b&gt;quiz_attempts&lt;/b&gt; (id, user_id, quiz_id, attempt_number, started_at, submitted_at, grade).&lt;br&gt;NOVA &lt;b&gt;attempt_answers&lt;/b&gt; (id, quiz_attempt_id, question_id, answer_id, is_correct), UNIQUE(quiz_attempt_id, question_id).&lt;br&gt;is_correct guardado na submissão (histórico não muda se o Manager corrigir answers.correct).&lt;br&gt;question_id mantido: permite registar perguntas deixadas em branco (answer_id vazio); a coerência com answers.question_id é validada no backend." vertex="1">
          <mxGeometry height="223.0" width="420" x="1960" y="130.0" as="geometry" />
        </mxCell>
        <mxCell id="decisao-p2" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;P2 – Tentativas&lt;/b&gt;&lt;br&gt;quiz_attempts.&lt;b&gt;attempt_number&lt;/b&gt;, UNIQUE(user_id, quiz_id, attempt_number).&lt;br&gt;quizzes.&lt;b&gt;max_attempts&lt;/b&gt; (diagnóstico 2, final 1).&lt;br&gt;Ganho usa a &lt;b&gt;1.ª tentativa&lt;/b&gt; do diagnóstico (ponto de partida real; a 2.ª já vem treinada).&lt;br&gt;quizzes: UNIQUE(resource_id, quiztype_id) – cada recurso tem no máximo um diagnóstico e um final.&lt;br&gt;grade de 0 a 100 (%): no ganho g = (pós − pré) / (100 − pré)." vertex="1">
          <mxGeometry height="250.0" width="420" x="1960" y="383.0" as="geometry" />
        </mxCell>
        <mxCell id="decisao-p3" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;P3 – Inscrição vs favorito&lt;/b&gt;&lt;br&gt;resource_user sai. &lt;b&gt;favorites&lt;/b&gt; (user_id, resource_id, created_at).&lt;br&gt;&lt;b&gt;enrollments&lt;/b&gt; (id, user_id, resource_id, enrollmentstate_id, enrolled_at, completed_at), UNIQUE(user_id, resource_id).&lt;br&gt;&lt;b&gt;enrollmentstates&lt;/b&gt;: inscrito, em curso, concluído, cancelado → taxa de conclusão.&lt;br&gt;resourcelevel_user.&lt;b&gt;enrollment_id&lt;/b&gt; (em vez de user_id): o progresso por nível pertence à inscrição, como no Modelo de Domínio." vertex="1">
          <mxGeometry height="208.0" width="420" x="1960" y="663.0" as="geometry" />
        </mxCell>
        <mxCell id="decisao-p4" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;P4 – Badges e certificados&lt;/b&gt;&lt;br&gt;Uma tabela &lt;b&gt;completions&lt;/b&gt; (id, enrollment_id, quiz_attempt_id, certificate_code UNIQUE, issued_at).&lt;br&gt;Badge = resources.badge_url do recurso. Regra 85% no backend, valor em quizzes.&lt;b&gt;pass_grade&lt;/b&gt; (default 85)." vertex="1">
          <mxGeometry height="142" width="420" x="1960" y="901.0" as="geometry" />
        </mxCell>
        <mxCell id="decisao-p5" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;P5 – Consentimento parental&lt;/b&gt;&lt;br&gt;NOVA &lt;b&gt;parental_consents&lt;/b&gt; (id, user_id, guardian_name, guardian_email, token_hash, requested_at, expires_at, consented_at, revoked_at).&lt;br&gt;Link com token no email. users.parental_consent sai.&lt;br&gt;userstates: pendente email, pendente consentimento, ativo, bloqueado. Sem consentimento até expires_at → conta apagada (RGPD)." vertex="1">
          <mxGeometry height="178" width="420" x="1960" y="1073.0" as="geometry" />
        </mxCell>
        <mxCell id="decisao-p6" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;P6 – PT/EN&lt;/b&gt;&lt;br&gt;NOVA &lt;b&gt;languages&lt;/b&gt; (id, code, name) + uma tabela &lt;b&gt;*_translations&lt;/b&gt; por entidade (resources, resourcelevels, healthareas, news, activities, contents, quizzes, questions, answers), UNIQUE(entidade_id, language_id).&lt;br&gt;3.º idioma = 1 linha nova. users.&lt;b&gt;language_id&lt;/b&gt; (default PT). Texto das tabelas base = PT (por defeito). Lookups traduzidos no frontend." vertex="1">
          <mxGeometry height="160" width="420" x="1960" y="1281.0" as="geometry" />
        </mxCell>
        <mxCell id="decisao-p7" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;P7 – Destaques da semana&lt;/b&gt;&lt;br&gt;NOVA &lt;b&gt;highlights&lt;/b&gt; (id, resource_id, news_id, activity_id, content_id – só uma preenchida –, starts_at, ends_at, position, created_by).&lt;br&gt;Regra CHECK garante que exatamente uma das 4 FKs (resource_id, news_id, activity_id, content_id) está preenchida." vertex="1">
          <mxGeometry height="133.0" width="420" x="1960" y="1471.0" as="geometry" />
        </mxCell>
        <mxCell id="decisao-p8" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;P8 – Limpeza (feita)&lt;/b&gt;&lt;br&gt;Cópias cinzentas de qastates e resourcestates apagadas; ligações passadas para as verdadeiras.&lt;br&gt;Seta contents→healthareas corrigida (sai de healtharea_id). 2 setas soltas ligadas.&lt;br&gt;Regra de nomes: inglês, plural; N:M singular_singular; novas em snake_case." vertex="1">
          <mxGeometry height="160" width="420" x="1960" y="1634.0" as="geometry" />
        </mxCell>
        <mxCell id="v11-13" parent="1" style="shape=table;startSize=30;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="attempt_answers" vertex="1">
